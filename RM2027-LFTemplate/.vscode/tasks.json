{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (make -j8)",
      "type": "shell",
      "command": "make",
      "args": ["-j8"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Rebuild",
      "type": "shell",
      "command": "make",
      "args": ["rebuild"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash (STM32CubeProgrammer)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/flash.ps1"
      ],
      "dependsOn": "Build (make -j8)",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Build and Flash",
      "dependsOrder": "sequence",
      "dependsOn": ["Flash (STM32CubeProgrammer)"],
      "problemMatcher": []
    }
  ]
}
